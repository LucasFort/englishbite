# Copie este arquivo para ".env" (local) ou configure estas variáveis
# diretamente no painel do Render (Environment). Nunca faça commit de um
# arquivo ".env" com valores reais.

# Obtenha em https://console.upstash.com (crie um banco Redis gratuito)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional: deixe em branco para rodar em modo teste (o código de
# verificação aparece na tela em vez de ser enviado por e-mail).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=EnglishBite

PORT=8793

# EnglishBite Pro (Mercado Pago). Pegue o Access Token de PRODUÇÃO em
# https://www.mercadopago.com.br/developers/panel → Suas integrações → Credenciais
MP_ACCESS_TOKEN=
# Endereço público do app (usado para o Mercado Pago avisar os pagamentos)
PUBLIC_URL=https://englishbite.onrender.com
# Preços (opcional; padrão 9.90 por mês e 89.90 por ano)
PRO_PRICE_MONTH=9.90
PRO_PRICE_YEAR=89.90
# Chave secreta para liberar o Pro manualmente (16+ caracteres). Deixe vazio para desativar.
ADMIN_KEY=
