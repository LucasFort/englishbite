# Copie este arquivo para ".env" (local) ou configure estas variáveis
# diretamente no painel do Render (Environment). Nunca faça commit de um
# arquivo ".env" com valores reais.

# Obtenha em https://console.upstash.com (crie um banco Redis gratuito)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional: deixe em branco para rodar em modo teste (o código de
# verificação aparece na tela em vez de ser enviado por e-mail).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=EnglishBite

PORT=8793
